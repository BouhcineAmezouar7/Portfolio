RESEND_API_KEY=
# With onboarding@resend.dev, use the email address on your Resend account.
CONTACT_EMAIL=you@example.com
# For production, use an address on a domain verified in Resend.
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key
# Exact Cloudflare widget hostnames, comma-separated. Vercel's production hostname is included automatically.
TURNSTILE_ALLOWED_HOSTNAMES=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional maximum submissions per IP per hour.
CONTACT_RATE_LIMIT=3
